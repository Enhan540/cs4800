MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=cs4800_database
SECRET_KEY=replace-with-a-long-random-value
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:5000/auth/google-calendar/callback
SESSION_COOKIE_SECURE=false
SUPPORT_EMAIL=
PORT=5000
APP_TIMEZONE=America/Los_Angeles
# unverified (default): published, Google shows an unverified-app warning; limited: Testing mode, approved users only; public: verified, no notice
GOOGLE_CALENDAR_ACCESS=unverified
# Private address that receives feedback and access requests (falls back to SUPPORT_EMAIL); never shown on pages
FEEDBACK_EMAIL=
